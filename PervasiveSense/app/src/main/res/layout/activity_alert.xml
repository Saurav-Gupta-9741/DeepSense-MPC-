<?xml version="1.0" encoding="utf-8"?>
<!-- Contact alert counting down, shown over the lock screen: one large answer, no unlocking needed. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:gravity="center"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvAlertScreenTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:textColor="@color/accent_rose"
        android:textSize="26sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAlertScreenSeconds"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:textColor="@color/text_main"
        android:textSize="72sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvAlertScreenDetail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center"
        android:textColor="@color/text_muted"
        android:textSize="16sp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAlertScreenOk"
        android:layout_width="match_parent"
        android:layout_height="96dp"
        android:layout_marginTop="32dp"
        android:text="@string/fit_alert_ok"
        android:textColor="@color/bg_dark"
        android:textSize="24sp"
        app:backgroundTint="@color/accent_emerald"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAlertScreenHelp"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:text="@string/fall_help_now"
        android:textColor="@color/text_main"
        android:textSize="18sp"
        android:visibility="gone"
        app:backgroundTint="@color/accent_rose"
        app:cornerRadius="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnAlertScreenCancel"
        android:layout_width="match_parent"
        android:layout_height="72dp"
        android:layout_marginTop="16dp"
        android:text="@string/fit_alert_cancel"
        android:textColor="@color/bg_dark"
        android:textSize="18sp"
        app:backgroundTint="@color/primary_cyan"
        app:cornerRadius="16dp" />
</LinearLayout>
