<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg_dark"
    android:orientation="vertical">

    <!-- ============ Header ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="20dp"
        android:paddingTop="16dp"
        android:paddingEnd="20dp"
        android:paddingBottom="8dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_name"
                android:textColor="@color/primary_glow"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                style="@style/PS.Caption"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/app_tagline" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvStatusPill"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_pill"
            android:paddingStart="12dp"
            android:paddingTop="4dp"
            android:paddingEnd="12dp"
            android:paddingBottom="4dp"
            android:text="@string/status_stopped"
            android:textColor="@color/bg_dark"
            android:textSize="11sp"
            android:textStyle="bold"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <!-- ============ Scrolling dashboard ============ -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="8dp"
            android:paddingEnd="16dp"
            android:paddingBottom="16dp">

            <!-- Current activity -->
            <com.google.android.material.card.MaterialCardView
                style="@style/PS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        style="@style/PS.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/section_current_activity" />

                    <TextView
                        android:id="@+id/tvCurrentActivity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/hero_not_running"
                        android:textColor="@color/text_muted"
                        android:textSize="32sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvActivityDetail"
                        style="@style/PS.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/hero_not_running_detail"
                        android:textSize="13sp" />

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressConfidence"
                        style="@style/PS.Bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="100" />

                    <TextView
                        style="@style/PS.Section"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="@string/section_model_output" />

                    <!-- One row per model class, created from the model's label file -->
                    <LinearLayout
                        android:id="@+id/probContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- HEALTH -->
            <TextView
                style="@style/PS.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_health" />

            <com.google.android.material.card.MaterialCardView
                style="@style/PS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/PS.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_posture" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tile"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView style="@style/PS.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tile_tilt" />
                            <TextView android:id="@+id/tvTiltValue" style="@style/PS.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" />
                            <TextView android:id="@+id/tvTiltState" style="@style/PS.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tile"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView style="@style/PS.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tile_fidget" />
                            <TextView android:id="@+id/tvFidgetValue" style="@style/PS.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" />
                            <TextView android:id="@+id/tvFidgetState" style="@style/PS.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tile"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView style="@style/PS.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/tile_sitting" />
                            <TextView android:id="@+id/tvSittingValue" style="@style/PS.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" />
                            <TextView android:id="@+id/tvSittingState" style="@style/PS.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" />
                        </LinearLayout>
                    </LinearLayout>

                    <com.google.android.material.progressindicator.LinearProgressIndicator
                        android:id="@+id/progressSitting"
                        style="@style/PS.Bar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:max="100" />

                    <TextView
                        style="@style/PS.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/sitting_hint" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/PS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/PS.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_wellness" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:gravity="center_horizontal"
                            android:orientation="vertical">

                            <FrameLayout
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content">

                                <com.google.android.material.progressindicator.CircularProgressIndicator
                                    android:id="@+id/progressWellness"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:max="100"
                                    app:indicatorColor="@color/accent_emerald"
                                    app:indicatorSize="92dp"
                                    app:trackColor="@color/track"
                                    app:trackThickness="8dp" />

                                <TextView
                                    android:id="@+id/tvWellnessScore"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_gravity="center"
                                    android:text="--"
                                    android:textColor="@color/text_main"
                                    android:textSize="28sp"
                                    android:textStyle="bold" />
                            </FrameLayout>

                            <TextView
                                android:id="@+id/tvWellnessGrade"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="--"
                                android:textColor="@color/text_muted"
                                android:textSize="12sp"
                                android:textStyle="bold" />
                        </LinearLayout>

                        <!-- Component scores -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="18dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
                                <TextView style="@style/PS.Caption" android:layout_width="84dp" android:layout_height="wrap_content" android:text="@string/score_diversity" />
                                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/barDiversity" style="@style/PS.Bar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="100" />
                                <TextView android:id="@+id/tvDiversityScore" style="@style/PS.Caption" android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="end" android:text="--" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                                <TextView style="@style/PS.Caption" android:layout_width="84dp" android:layout_height="wrap_content" android:text="@string/score_ergonomic" />
                                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/barErgonomic" style="@style/PS.Bar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="100" />
                                <TextView android:id="@+id/tvErgonomicScore" style="@style/PS.Caption" android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="end" android:text="--" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                                <TextView style="@style/PS.Caption" android:layout_width="84dp" android:layout_height="wrap_content" android:text="@string/score_movement" />
                                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/barMovement" style="@style/PS.Bar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="100" />
                                <TextView android:id="@+id/tvMovementScore" style="@style/PS.Caption" android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="end" android:text="--" />
                            </LinearLayout>

                            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center_vertical" android:orientation="horizontal">
                                <TextView style="@style/PS.Caption" android:layout_width="84dp" android:layout_height="wrap_content" android:text="@string/score_safety" />
                                <com.google.android.material.progressindicator.LinearProgressIndicator android:id="@+id/barSafety" style="@style/PS.Bar" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:max="100" />
                                <TextView android:id="@+id/tvSafetyScore" style="@style/PS.Caption" android:layout_width="32dp" android:layout_height="wrap_content" android:gravity="end" android:text="--" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvWellnessSummary"
                        style="@style/PS.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:text="--" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- SAFETY & TRAVEL -->
            <TextView
                style="@style/PS.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_safety_travel" />

            <com.google.android.material.card.MaterialCardView
                style="@style/PS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            style="@style/PS.CardTitle"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="@string/card_fall" />

                        <View
                            android:id="@+id/fallDot"
                            android:layout_width="10dp"
                            android:layout_height="10dp"
                            android:background="@drawable/bg_dot" />

                        <TextView
                            android:id="@+id/tvFallStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:text="@string/fall_monitoring"
                            android:textColor="@color/accent_emerald"
                            android:textSize="13sp"
                            android:textStyle="bold" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/tvFallDetail"
                        style="@style/PS.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:text="@string/fall_monitoring_detail" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnFallAck"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="@string/fall_ack"
                        android:textColor="@color/bg_dark"
                        android:visibility="gone"
                        app:backgroundTint="@color/accent_amber"
                        app:cornerRadius="12dp" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                style="@style/PS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/PS.CardTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_road" />

                    <TextView
                        android:id="@+id/tvRoadStatus"
                        style="@style/PS.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:text="@string/road_paused" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tile"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView style="@style/PS.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/road_potholes" />
                            <TextView android:id="@+id/tvPotholesCount" style="@style/PS.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/accent_rose" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_weight="1"
                            android:background="@drawable/bg_tile"
                            android:orientation="vertical"
                            android:padding="12dp">
                            <TextView style="@style/PS.Caption" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="@string/road_breakers" />
                            <TextView android:id="@+id/tvSpeedBreakersCount" style="@style/PS.Value" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="0" android:textColor="@color/primary_glow" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- ACTIVITY LOG -->
            <TextView
                style="@style/PS.Section"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="4dp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="8dp"
                android:text="@string/section_log" />

            <com.google.android.material.card.MaterialCardView
                style="@style/PS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        style="@style/PS.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/card_transitions" />

                    <TextView
                        android:id="@+id/tvLastTransition"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/transition_none"
                        android:textColor="@color/primary_glow"
                        android:textSize="16sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvTransitionMeta"
                        style="@style/PS.Caption"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Diagnostics: collapsed by default -->
            <com.google.android.material.card.MaterialCardView
                style="@style/PS.Card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <TextView
                        android:id="@+id/tvDiagnosticsToggle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="32dp"
                        android:gravity="center_vertical"
                        android:text="@string/diagnostics_show"
                        android:textColor="@color/text_muted"
                        android:textSize="13sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:id="@+id/diagnosticsContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/tvLiveSensor"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="monospace"
                            android:text="--"
                            android:textColor="@color/text_main"
                            android:textSize="11sp" />

                        <TextView
                            android:id="@+id/tvEngineInfo"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="8dp"
                            android:fontFamily="monospace"
                            android:text="--"
                            android:textColor="@color/text_muted"
                            android:textSize="11sp" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>
        </LinearLayout>
    </ScrollView>

    <!-- ============ Bottom control bar ============ -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/card_dark"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingTop="10dp"
        android:paddingEnd="16dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/tvServiceMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="8dp"
            android:text=""
            android:textColor="@color/accent_amber"
            android:textSize="12sp"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnToggleService"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="@string/action_start"
            android:textColor="@color/bg_dark"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary_cyan"
            app:cornerRadius="14dp" />
    </LinearLayout>
</LinearLayout>
