    <!-- Fit to drive: screen -->
    <string name="fit_title">Fit to drive</string>
    <string name="fit_subtitle">Compares your walk to the car with your own normal walk</string>
    <string name="fit_enable">Fit-to-drive check</string>
    <string name="fit_not_running">Sensing is stopped. Start it on the dashboard to use the check.</string>
    <string name="fit_disabled_hint">Turn on the check to start learning your normal walk. Nothing is recorded while it is off.</string>
    <string name="fit_consent_title">Turn on the fit-to-drive check?</string>
    <string name="fit_consent_body">PervasiveSense will learn how you normally walk from your everyday walking (best after 1–2 weeks), then compare the walk to your car with it.\n\n• It flags walking that is unusual for you, not alcohol itself. Tiredness, an injury, new shoes or a heavy bag can also change your walk.\n• It only gives advice. It is not a breathalyser and never legal evidence.\n• Everything stays on this phone. You can turn it off or forget the learned data at any time.</string>
    <string name="fit_consent_ok">Turn on</string>
    <string name="fit_cancel">Cancel</string>

