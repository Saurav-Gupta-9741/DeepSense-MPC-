<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.PervasiveSense" parent="Theme.Material3.Dark.NoActionBar">
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:navigationBarColor">@color/card_dark</item>
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="colorPrimary">@color/primary_cyan</item>
    </style>

    <!-- One card style for the whole dashboard -->
    <style name="PS.Card" parent="Widget.Material3.CardView.Outlined">
        <item name="cardBackgroundColor">@color/card_dark</item>
        <item name="cardCornerRadius">16dp</item>
        <item name="strokeColor">@color/card_border</item>
        <item name="strokeWidth">1dp</item>
        <item name="cardElevation">0dp</item>
        <item name="android:layout_marginBottom">12dp</item>
    </style>

    <style name="PS.Section">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PS.CardTitle">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PS.Caption">
        <item name="android:textColor">@color/text_muted</item>
        <item name="android:textSize">12sp</item>
    </style>

    <style name="PS.Value">
        <item name="android:textColor">@color/text_main</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="PS.Bar" parent="Widget.Material3.LinearProgressIndicator">
        <item name="trackColor">@color/track</item>
        <item name="indicatorColor">@color/primary_cyan</item>
        <item name="trackCornerRadius">3dp</item>
        <item name="trackThickness">6dp</item>
    </style>
</resources>
