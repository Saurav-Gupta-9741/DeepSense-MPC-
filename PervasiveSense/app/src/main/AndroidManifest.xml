<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Continuous sensing in a foreground service. "health" is the correct Android 14+
         type for fitness / activity tracking; it requires ACTIVITY_RECOGNITION at runtime. -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_HEALTH" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Activity recognition: vehicle detection (Play services) and the hardware step counter. -->
    <uses-permission android:name="android.permission.ACTIVITY_RECOGNITION" />
    <uses-permission
        android:name="com.google.android.gms.permission.ACTIVITY_RECOGNITION"
        android:maxSdkVersion="28" />

    <!-- Fit-to-drive (optional): notice the car's Bluetooth connecting, to check before the car moves. -->
    <uses-permission
        android:name="android.permission.BLUETOOTH"
        android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Fit to drive, opt-in contact alert: a text message, with the location if allowed. -->
    <uses-permission android:name="android.permission.SEND_SMS" />
    <!-- Optional: after the text, phone the contact on speaker. -->
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <!-- Sensing restarts after the phone restarts or the app is updated, if it was running. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Asks to be left out of battery optimisation, so the watch keeps running with the screen locked. -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />
    <!-- An alert countdown ("Are you OK?") opens over the lock screen, so the driver can answer without unlocking. -->
    <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
    <!-- Optional: lists the SIMs so the contact alert can try another one (dual SIM). -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />

    <uses-feature android:name="android.hardware.sensor.accelerometer" android:required="true" />
    <uses-feature android:name="android.hardware.sensor.gyroscope" android:required="false" />
    <uses-feature android:name="android.hardware.sensor.stepcounter" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <uses-feature android:name="android.hardware.telephony" android:required="false" />
    <uses-feature android:name="android.hardware.location" android:required="false" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PervasiveSense"
        tools:targetApi="34">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:theme="@style/Theme.PervasiveSense">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".FitToDriveActivity"
            android:exported="false"
            android:label="@string/fit_title"
            android:launchMode="singleTop"
            android:parentActivityName=".MainActivity"
            android:theme="@style/Theme.PervasiveSense" />

        <!-- A contact alert counting down, over the lock screen (from the alert's full-screen notification). -->
        <activity
            android:name=".AlertActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:launchMode="singleTop"
            android:taskAffinity="com.iitj.pervasivesense.alert"
            android:theme="@style/Theme.PervasiveSense" />

        <service
            android:name=".SensingForegroundService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="health|location" />

        <!-- Receives Google Activity Recognition results through our own PendingIntent. -->
        <receiver
            android:name=".VehicleActivityReceiver"
            android:exported="false" />

        <!-- Restarts sensing after a reboot or an app update (only if it was running). -->
        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Restarts sensing if the phone stopped it (every 15 min, and after the app is swiped away). -->
        <receiver
            android:name=".WatchdogReceiver"
            android:exported="false" />

    </application>

</manifest>
